# Hi3DGen runner configuration. Copy to .env (install.ps1 does this for you).
# Absolute paths only: the runner is started as a separate process.

HI3DGEN_REPO=__REPO__
HI3DGEN_WEIGHTS_DIR=__WEIGHTS__\trellis-normal-v0-1
HI3DGEN_BIREFNET_DIR=__WEIGHTS__\BiRefNet
HI3DGEN_NORMAL_CACHE_DIR=__WEIGHTS__
HI3DGEN_NORMAL_HUB=hugoycj/StableNormal
HI3DGEN_NORMAL_VERSION=yoso-normal-v1-8-1
HI3DGEN_NORMAL_RESOLUTION=768

# Sampler defaults, from the upstream demo (app.py).
HI3DGEN_SS_STEPS=50
HI3DGEN_SLAT_STEPS=6
HI3DGEN_SS_GUIDANCE=3.0
HI3DGEN_SLAT_GUIDANCE=3.0

HI3DGEN_ATTN_HEAD_CHUNK=4

# Set TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 before torch is imported.
# Measured on gfx1151: attention becomes 10-20x faster. No effect if set later.
HI3DGEN_FAST_ATTENTION=on

# Keep a hidden 3D render loop alive while generating (gfxlight.py). The AMD
# Windows driver leaves the GPU at ~600 MHz for compute-only work; with a tiny
# 3D load alongside it sustains 2.3+ GHz. Measured 4.3x on GEMM.
HI3DGEN_GFX_KEEPALIVE=on

# Dedicated VRAM is 32 GB; mem_get_info reports 43.87 GB because it counts
# shared memory. Spilling is silent and slow, so the cap is given to torch too.
HI3DGEN_VRAM_LIMIT_GB=30
HI3DGEN_HEARTBEAT_SEC=10

# Post-processing. Upstream has none, so only two measured defects are treated:
# the flat opening at the top of the generation volume, and free-floating parts.
HI3DGEN_FILL_HOLES_MAX_NBE=250
HI3DGEN_DROP_SMALL_PARTS=0.10
